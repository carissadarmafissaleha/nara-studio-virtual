# Semua hasil order /buat-video tidak masuk repo: komposisi, aset, dan registry.
# Registry di-generate ulang oleh scripts/regen-registry.mjs saat server start,
# `npm run build`, dan `npm run remotion:render`.
src/remotion/compositions/*
src/remotion/registry.ts
public/assets/*

# One-off scratch / patch scripts
scripts/patch-*
scripts/add-quick-execute.py
scripts/fix-server-imports.py
scripts/move-agent-card.py
scripts/seed-agents.py
scripts/generate-audio.py
scripts/generate-sfx.py

# Skrip produksi sekali pakai (dibuat per order, bukan bagian pipeline).
# File tetap ada di disk; hanya tidak ikut repo.
scripts/make-*.mjs
scripts/make-*-assets.py
scripts/*-cv-audio.mjs
scripts/generate-*-vo.mjs

# Rumah untuk skrip & artefak per order /buat-video (generator, storyboard,
# catatan produksi). scripts/ hanya untuk pipeline bersama.
productions/

